# NSE AI Platform — Environment Variables
# Copy this file to .env and fill in your keys


# Database (Docker)
DATABASE_URL=postgresql://nse_user:nse_pass@localhost:5432/nse_db

# Google OAuth — get from console.cloud.google.com → APIs & Services → Credentials
# Application type: Web application
# Authorized JavaScript origins: http://localhost:5500, http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
