# ==============================================================================
# NSE AI Platform — Environment Variables Example
# Copy this file to .env and fill in your optional keys:
#   cp .env.example .env
# ==============================================================================

# Database (Default: local SQLite database with 349k+ historical stock records)
DATABASE_URL=sqlite:///./nse_users.db

# If using PostgreSQL / TimescaleDB via Docker (infra/docker-compose.yml):
# DATABASE_URL=postgresql://nse_user:nse_pass@localhost:5432/nse_db

# Security & JWT
JWT_SECRET_KEY=nse-ai-platform-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# (Optional) Google OAuth Client ID for "Sign in with Google" on login.html
GOOGLE_CLIENT_ID=

# (Optional) OpenAI API Key for conversational AI Copilot
OPENAI_API_KEY=

# (Optional) Africa's Talking API for real SMS notifications
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=

# Machine Learning & Quantitative Signal Settings
ENABLE_ML_MODEL=true
CONFIDENCE_THRESHOLD=0.75

# Scraper & Anti-IP-Ban Protection
# Leave empty for direct polite connections, or provide HTTP/HTTPS/SOCKS5 proxy:
# SCRAPER_PROXY=socks5h://127.0.0.1:9050
# SCRAPER_PROXY=http://user:password@proxy.example.com:8080
SCRAPER_PROXY=
SCRAPER_CACHE_TTL=600
