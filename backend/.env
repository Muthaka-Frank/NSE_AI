# NSE AI Platform — Environment Variables

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=nse-ai-change-this-to-a-long-random-secret-in-production

# Google OAuth — get from console.cloud.google.com → APIs & Services → Credentials
# Application type: Web application
# Authorized JavaScript origins: http://localhost:5500
GOOGLE_CLIENT_ID=1001571112369-git0fg2eld2h6lcnsp8215gu7msmjptj.apps.googleusercontent.com

# ── Data Sources ──────────────────────────────────────────────────────────────
# Alpha Vantage (free tier: 25 req/day, 500 req/month)
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=PQNJSA31CW8G4WU5

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite file (nse_users.db) — no setup needed
# Uncomment and set for PostgreSQL in production:
# DATABASE_URL=postgresql://nse_user:nse_pass@localhost:5432/nse_db
